{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*", "tests/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["ember-source/types", "@glint/ember-tsc/types", "vite/client"],
    "paths": {
      "@tanstack/ember-form": ["./src/index.ts"],
      "@tanstack/ember-form/*": ["./src/*"]
    }
  }
}
